# Server
PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGIN=
# Public URL used to build report download links returned to clients
# (e.g. https://launch.usdegrees.com in production). Must NOT be 127.0.0.1
# or localhost in production, or download links will fail for end users.
PUBLIC_APP_URL=http://localhost:8000

# Database (Supabase / Postgres)
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# App JWT (backend-issued token used on every protected request)
JWT_SECRET=
APP_JWT_TTL=30m

# Report-download token secret — MUST be different from JWT_SECRET. These
# tokens are embedded in URLs/emails (higher exposure surface than the app
# auth header), so they are signed and verified independently.
REPORT_DOWNLOAD_TOKEN_SECRET=

# SMTP (used to email report download links)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase Admin — service account. NEVER commit real values.
# Option A: path to the service-account JSON file (preferred — no newline escaping).
# FIREBASE_SERVICE_ACCOUNT_PATH or the standard GOOGLE_APPLICATION_CREDENTIALS work.
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: individual fields (FIREBASE_PRIVATE_KEY may contain \n escapes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Per-visitor rate limiting (Render setup) ---
# The frontend is hosted on a client AWS server (NOT Vercel) and calls this API
# server-side, so req.ip alone is that server's address. It forwards the visitor
# IP as X-Client-IP + X-Proxy-Signature (hex HMAC-SHA256 of the IP).
#
# PROXY_IP_SECRET must be IDENTICAL here (Render env) and on the frontend's AWS
# server. Generate once with: openssl rand -hex 32. Never commit a real value.
# If unset (or mismatched) the headers are ignored and all frontend traffic
# shares one rate-limit bucket (req.ip) - nothing breaks, limits are just coarse.
PROXY_IP_SECRET=
# Reverse-proxy hops in front of the API (Render = 1). Drives req.ip, the
# fallback rate-limit key. To verify: set DEBUG_CLIENT_IP=1 on Render, hit the
# API from a known IP, and check the logs - "req.ip" must be that visitor/caller
# IP, not a Render internal address (too low = Render's IP; too high = spoofable
# X-Forwarded-For). Then unset DEBUG_CLIENT_IP. It logs IPs only, never the
# secret or signature, and is off by default.
TRUST_PROXY_HOPS=1
DEBUG_CLIENT_IP=
# Rate limits (requests per minute)
CATALOG_RATE_LIMIT_ANON_PER_MIN=60
CATALOG_RATE_LIMIT_AUTH_PER_MIN=120
SITEMAP_RATE_LIMIT_PER_MIN=30

# --- Stripe (report credit packs) ---
# Test keys from the Stripe sandbox. NEVER commit real values.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...). Local dev: `stripe listen --forward-to localhost:8000/billing/webhook` prints it.
STRIPE_WEBHOOK_SECRET=
# true = /report/generate spends one credit per report (402 PAYMENT_REQUIRED when none). Default off.
STRIPE_REQUIRE_PAYMENT=false
# Placeholder demo pack (real pricing TBD)
STRIPE_DEMO_PACK_CREDITS=3
STRIPE_DEMO_PACK_PRICE_CENTS=100
